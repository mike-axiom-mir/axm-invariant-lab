{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/counterexample-packet-v0.1.json",
  "title": "AXM Invariant Lab Counterexample Packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model",
    "claim",
    "status",
    "bound",
    "invariant",
    "trace",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "axm.invariant-lab.counterexample/v0.1"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "FAIL",
        "HOLD"
      ]
    },
    "bound": {
      "type": "integer",
      "minimum": 0
    },
    "invariant": {
      "type": "string",
      "minLength": 1
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transition",
          "before",
          "after"
        ],
        "properties": {
          "transition": {
            "type": "string"
          },
          "before": {
            "type": "object"
          },
          "after": {
            "type": "object"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge",
        "canon",
        "execution",
        "promotion"
      ],
      "properties": {
        "merge": {
          "const": false
        },
        "canon": {
          "const": false
        },
        "execution": {
          "const": false
        },
        "promotion": {
          "const": false
        }
      }
    }
  }
}
